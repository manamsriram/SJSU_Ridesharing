# Auth Service Environment Variables

# Server
NODE_ENV=development
AUTH_SERVICE_PORT=3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/lessgo_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# File Upload
UPLOAD_DIR=./uploads

# AWS S3 (Optional - for SJSU ID storage)
AWS_S3_BUCKET=lessgo-sjsu-ids
AWS_REGION=us-west-1

# SMTP (for OTP verification emails — leave blank to use console stub in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=LessGo <noreply@lessgo.app>
